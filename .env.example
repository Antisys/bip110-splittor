# Network mode: 'regtest' or 'mainnet'
NETWORK_MODE=regtest

# Bitcoin RPC (mainchain)
BITCOIN_RPC_HOST=127.0.0.1:18443
BITCOIN_RPC_USER=user
BITCOIN_RPC_PASSWORD=password

# BIP110 RPC (BIP110 chain)
BIP110_RPC_HOST=127.0.0.1:18444
BIP110_RPC_USER=user
BIP110_RPC_PASSWORD=password

# Explorer URLs (fallback if no RPC)
BITCOIN_EXPLORER_URL=https://mempool.space
BIP110_EXPLORER_URL=

# Nostr Orderbook
# Comma-separated relay URLs
NOSTR_RELAYS=wss://damus.io
# Nostr secret key (hex). If empty, a new keypair is generated on first start.
NOSTR_SECRET_KEY=

# Server
PORT=4000
